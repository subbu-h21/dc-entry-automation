OPENROUTER_API_KEY=your_openrouter_api_key_here
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# Claude reads DC photos on the Lite and Pro models. It must come from the Claude
# Console organisation that holds the API credit. Left blank, or if Claude fails,
# those models quietly use Gemini through OpenRouter instead.
ANTHROPIC_KEY=
PORT=3001
ALLOWED_ORIGINS=http://localhost:5173
PRODUCT_LIST_PATH=../Product_List.xlsx
DC_PIPELINE_URL=http://localhost:3002

# CRM DC Inward API. No default for the address on purpose: a save raises real
# stock. app.shubhadahealth.com is the TEST server.
CRM_API_BASE_URL=http://app.shubhadahealth.com/api
CRM_CLIENT_ID=
CRM_CLIENT_SECRET=
# Created By when the Checked By person isn't set up for that branch in the CRM.
CRM_DEFAULT_EMPLOYEE_ID=386

# PIN for the /admin page (product-catalog upload). Ships
# working out of the box; change here to rotate it.
ADMIN_PIN=2009
